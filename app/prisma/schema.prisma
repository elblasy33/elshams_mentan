generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  RECEPTION
  TECHNICIAN
  FIELD_TECHNICIAN
  INVENTORY
  CASHIER
  QC
  AUDITOR
}

enum CustomerType {
  INDIVIDUAL
  SHOP
  COMPANY
  COMMERCIAL
}

enum IntakeChannel {
  BRANCH
  PICKUP
  COMMERCIAL
  OTHER
}

enum ExecutionMode {
  INTERNAL
  FIELD
  EXTERNAL
}

enum Priority {
  NORMAL
  HIGH
  URGENT
}

// DRAFT و AWAITING_EXTERNAL مؤجلتان للمرحلة الرابعة (انظر docs/SCOPE.md)
enum OrderStatus {
  RECEIVED
  AWAITING_INSPECTION
  INSPECTING
  AWAITING_QUOTE
  AWAITING_APPROVAL
  AWAITING_PARTS
  READY_TO_REPAIR
  REPAIRING
  AWAITING_TEST
  REWORK
  REPAIRED
  READY_FOR_DELIVERY
  DELIVERED
  REJECTED
  CANCELLED
}

enum QuotationStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  EXPIRED
  SUPERSEDED
}

enum LineType {
  INSPECTION
  LABOR
  PART
  SERVICE
}

enum MovementType {
  RECEIPT
  ISSUE
  RETURN
  ADJUSTMENT
  DAMAGE
}

enum PaymentKind {
  DEPOSIT
  PAYMENT
  REFUND
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  WALLET
  CARD
  OTHER
}

enum TestResult {
  PASS
  FAIL
  RECHECK
  NA
}

enum WarrantyDecision {
  ACCEPTED
  REJECTED
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  name         String
  passwordHash String
  role         Role
  extraPerms   String[] @default([])
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedOrders ServiceOrder[] @relation("Technician")
  receivedOrders ServiceOrder[] @relation("Receiver")
}

model Customer {
  id         String       @id @default(cuid())
  code       String       @unique
  name       String
  type       CustomerType @default(INDIVIDUAL)
  phone      String
  phone2     String?
  email      String?
  address    String?
  taxNo      String?
  notes      String?
  archivedAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  devices  CustomerDevice[]
  orders   ServiceOrder[]
  payments Payment[]
  warranties Warranty[]

  @@index([phone])
  @@index([name])
}

model DeviceType {
  id      String @id @default(cuid())
  code    String @unique
  nameAr  String
  hasSerial Boolean @default(true)
  devices CustomerDevice[]
}

model CustomerDevice {
  id         String   @id @default(cuid())
  customerId String
  typeId     String
  brand      String?
  model      String?
  serial     String?
  size       String?
  color      String?
  notes      String?
  createdAt  DateTime @default(now())

  customer Customer   @relation(fields: [customerId], references: [id])
  type     DeviceType @relation(fields: [typeId], references: [id])
  orders   ServiceOrder[]
  warranties Warranty[]

  @@index([customerId])
  @@index([serial])
}

model ServiceOrder {
  id            String        @id @default(cuid())
  number        String        @unique
  customerId    String
  deviceId      String
  intakeChannel IntakeChannel @default(BRANCH)
  executionMode ExecutionMode @default(INTERNAL)
  status        OrderStatus   @default(RECEIVED)
  priority      Priority      @default(NORMAL)
  complaint     String
  intakeCondition String?
  accessories   String?
  receivedAt    DateTime      @default(now())
  expectedAt    DateTime?
  receivedById  String
  technicianId  String?
  internalNotes String?
  customerNotes String?
  diagnosis     String?
  repairNotes   String?
  delayReason   String?
  // الضمان
  warrantyOfId     String?
  warrantyDecision WarrantyDecision?
  warrantyReason   String?
  warrantyCovered  Boolean?
  // الرفض/التسليم
  rejectionReason String?
  deliveredAt     DateTime?
  deliveredTo     String?
  deliveryNote    String?
  deliveryOverride String?
  version       Int           @default(1)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  customer   Customer       @relation(fields: [customerId], references: [id])
  device     CustomerDevice @relation(fields: [deviceId], references: [id])
  receivedBy User           @relation("Receiver", fields: [receivedById], references: [id])
  technician User?          @relation("Technician", fields: [technicianId], references: [id])
  warrantyOf ServiceOrder?  @relation("WarrantyReturn", fields: [warrantyOfId], references: [id])
  returns    ServiceOrder[] @relation("WarrantyReturn")
  history    OrderStatusHistory[]
  quotations Quotation[]
  payments   Payment[]
  parts      OrderPart[]
  movements  StockMovement[]
  tests      QualityTest[]
  warranty   Warranty?

  @@index([status])
  @@index([customerId])
  @@index([deviceId])
  @@index([technicianId])
  @@index([receivedAt])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  from      OrderStatus?
  to        OrderStatus
  userId    String
  note      String?
  createdAt DateTime    @default(now())

  order ServiceOrder @relation(fields: [orderId], references: [id])

  @@index([orderId, createdAt])
}

model Quotation {
  id            String          @id @default(cuid())
  orderId       String
  version       Int
  status        QuotationStatus @default(DRAFT)
  discount      Decimal         @default(0) @db.Decimal(12, 2)
  taxRate       Decimal         @default(0) @db.Decimal(5, 2)
  subtotal      Decimal         @default(0) @db.Decimal(12, 2)
  taxAmount     Decimal         @default(0) @db.Decimal(12, 2)
  total         Decimal         @default(0) @db.Decimal(12, 2)
  validUntil    DateTime?
  terms         String?
  notes         String?
  // الموافقة اليدوية
  approvedAt     DateTime?
  approvalBy     String?
  approvalChannel String?
  approvalContactAt DateTime?
  approvalNote   String?
  rejectionReason String?
  createdById   String
  createdAt     DateTime        @default(now())

  order ServiceOrder @relation(fields: [orderId], references: [id])
  lines QuotationLine[]

  @@unique([orderId, version])
}

model QuotationLine {
  id          String   @id @default(cuid())
  quotationId String
  type        LineType
  description String
  partId      String?
  qty         Decimal  @default(1) @db.Decimal(12, 3)
  unitPrice   Decimal  @db.Decimal(12, 2)
  estUnitCost Decimal? @db.Decimal(12, 4)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  part      SparePart? @relation(fields: [partId], references: [id])

  @@index([quotationId])
}

model SparePart {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  category     String?
  unit         String   @default("قطعة")
  avgCost      Decimal  @default(0) @db.Decimal(12, 4)
  salePrice    Decimal  @default(0) @db.Decimal(12, 2)
  onHand       Decimal  @default(0) @db.Decimal(12, 3)
  reorderLevel Decimal  @default(0) @db.Decimal(12, 3)
  location     String?
  compatible   String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  movements StockMovement[]
  orderParts OrderPart[]
  lines     QuotationLine[]
}

model StockMovement {
  id           String       @id @default(cuid())
  type         MovementType
  partId       String
  qtyDelta     Decimal      @db.Decimal(12, 3)
  unitCost     Decimal      @db.Decimal(12, 4)
  balanceAfter Decimal      @db.Decimal(12, 3)
  orderId      String?
  reference    String?
  reason       String?
  userId       String
  idempotencyKey String?    @unique
  createdAt    DateTime     @default(now())

  part  SparePart     @relation(fields: [partId], references: [id])
  order ServiceOrder? @relation(fields: [orderId], references: [id])

  @@index([partId, createdAt])
  @@index([orderId])
}

// القطع المصروفة فعليًا لأمر صيانة (صافي المصروف = qtyIssued - qtyReturned)
model OrderPart {
  id          String   @id @default(cuid())
  orderId     String
  partId      String
  qtyIssued   Decimal  @default(0) @db.Decimal(12, 3)
  qtyReturned Decimal  @default(0) @db.Decimal(12, 3)
  qtyDamaged  Decimal  @default(0) @db.Decimal(12, 3)
  // تكلفة الصرف مرجّحة بالكمية (تُحدّث مع كل صرف)
  costTotal   Decimal  @default(0) @db.Decimal(14, 4)

  order ServiceOrder @relation(fields: [orderId], references: [id])
  part  SparePart    @relation(fields: [partId], references: [id])

  @@unique([orderId, partId])
}

model Payment {
  id         String        @id @default(cuid())
  number     String        @unique
  orderId    String
  customerId String
  kind       PaymentKind
  method     PaymentMethod @default(CASH)
  amount     Decimal       @db.Decimal(12, 2)
  reason     String?
  userId     String
  idempotencyKey String?   @unique
  createdAt  DateTime      @default(now())

  order    ServiceOrder @relation(fields: [orderId], references: [id])
  customer Customer     @relation(fields: [customerId], references: [id])

  @@index([orderId])
  @@index([customerId])
  @@index([createdAt])
}

model QualityTest {
  id        String     @id @default(cuid())
  orderId   String
  round     Int
  result    TestResult
  items     Json
  notes     String?
  userId    String
  createdAt DateTime   @default(now())

  order ServiceOrder @relation(fields: [orderId], references: [id])

  @@unique([orderId, round])
}

model Warranty {
  id         String   @id @default(cuid())
  number     String   @unique
  orderId    String   @unique
  customerId String
  deviceId   String
  startsAt   DateTime
  endsAt     DateTime
  months     Int
  coverage   String
  exclusions String?
  terms      String?
  createdAt  DateTime @default(now())

  order    ServiceOrder   @relation(fields: [orderId], references: [id])
  customer Customer       @relation(fields: [customerId], references: [id])
  device   CustomerDevice @relation(fields: [deviceId], references: [id])

  @@index([deviceId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  data      Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

model Sequence {
  key   String @id
  value Int    @default(0)
}

model Setting {
  key   String @id
  value Json
}
